# Copy this file to .env and fill it in. .env is git-ignored - never commit it.

# Required: Claude API key from https://console.anthropic.com/ (Settings -> API keys)
ANTHROPIC_API_KEY=

# For interview-callback alerts: the Gmail address you apply with + a Gmail App Password
# (Google Account -> Security -> 2-Step Verification -> App passwords). NOT your normal password.
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=

# Optional free job APIs (more India jobs):
# Adzuna: https://developer.adzuna.com/signup
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Jooble: https://jooble.org/api/about
JOOBLE_API_KEY=
